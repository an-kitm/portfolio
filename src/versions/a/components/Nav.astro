---
import { person } from '../../../content/site';
---

<header class="a-header">
  <nav class="a-nav a-wrap" aria-label="Primary">
    <a class="a-brand" href="#top">
      <svg width="28" height="28" viewBox="0 0 28 28" aria-hidden="true" focusable="false">
        <polygon points="3,9.5 14,16 14,27 3,20.5" fill="#1C2C43"></polygon>
        <polygon points="25,9.5 14,16 14,27 25,20.5" fill="#152132"></polygon>
        <polygon points="14,3 25,9.5 14,16 3,9.5" fill="#283F5E"></polygon>
      </svg>
      <span>{person.name}</span>
    </a>
    <button class="a-menu-btn" type="button" aria-expanded="false" aria-controls="a-menu" aria-label="Open menu">
      <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true" focusable="false">
        <path d="M3 7h14M3 13h14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
      </svg>
    </button>
    <ul class="a-links" id="a-menu">
      <li><a href="#work">Work</a></li>
      <li><a href="#atlas">Atlas</a></li>
      <li><a href="#principles">How I work</a></li>
      <li><a href="#toolkit">Toolkit</a></li>
      <li><a href="#contact">Contact</a></li>
      <li><a class="a-btn a-btn--primary a-btn--sm" href={`mailto:${person.email}`}>Email me</a></li>
    </ul>
  </nav>
</header>
