---
import { toolkit } from '../../../content/site';
---

<section class="a-toolkit a-wrap" id="toolkit" aria-labelledby="toolkit-title">
  <header class="a-head">
    <p class="a-eyebrow a-eyebrow--sm">Toolkit</p>
    <h2 class="a-h2 a-h2--section" id="toolkit-title">What I work with</h2>
  </header>
  <div class="a-toolkit__groups">
    {
      toolkit.groups.map((g) => (
        <div class="a-toolkit__group">
          <h3>{g.title}</h3>
          <ul class="a-pills">
            {g.items.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>
