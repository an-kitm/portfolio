---
import { atlas, companies } from '../../../content/site';

// Tags label each district of the town in the opening view, in walking order.
const tags = [
  ...(['even', 'pixis', 'noesys'] as const).map((id) => {
    const c = companies.find((x) => x.id === id);
    return { id, name: c?.name ?? id, period: c?.period ?? '', now: id === 'even' };
  }),
  { id: 'atlas', name: atlas.name, period: 'Side project', now: false },
];
---

<canvas class="a3d-canvas" aria-hidden="true"></canvas>
<div class="a3d-overlay">
  {
    tags.map((t) => (
      <a class="a3d-tag" data-district={t.id} href={`#${t.id}`}>
        <span class="a-tag__name">
          {t.name}
          {t.now && <span class="a-now">Now</span>}
        </span>
        <span class="a-tag__period">{t.period}</span>
      </a>
    ))
  }
  <p class="a3d-hint" aria-hidden="true">Scroll to walk through the town</p>
  {
    [1, 2, 3].map((n) => (
      <div class="a3d-blocklabel" aria-hidden="true" data-n={n}>
        <span class="a3d-blocklabel__num">{String(n).padStart(2, '0')}</span>
        <span class="a3d-blocklabel__title" />
      </div>
    ))
  }

  <button class="a3d-roam-btn" type="button">
    <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <circle cx="9" cy="2.6" r="1.6" fill="currentColor"></circle>
      <path
        d="M8.2 5.2 6 6.6 5 9.2M8.2 5.2l.9 3.6 2.4 1.4M9.1 8.8 7.4 11.4 7.8 14.6M9.1 8.8l1.3 2.8L12.2 14"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        stroke-linecap="round"
        stroke-linejoin="round"></path>
    </svg>
    Explore the town
  </button>

  <div class="a3d-roam" role="region" aria-label="Exploring the town" tabindex="-1" hidden>
    <button class="a3d-roam__exit" type="button">
      Back to the page
      <kbd>Esc</kbd>
    </button>
    <p class="a3d-roam__keys a3d-roam__keys--keyboard">
      <span><kbd>WASD</kbd> Move</span>
      <span><kbd>Shift</kbd> Run</span>
      <span><kbd>Space</kbd> Jump</span>
      <span>or click where to go</span>
    </p>
    <p class="a3d-roam__keys a3d-roam__keys--touch">Tap where you want to walk</p>
    <div class="a3d-roam__card" aria-live="polite" hidden>
      <p class="a3d-roam__eyebrow"></p>
      <p class="a3d-roam__title"></p>
      <p class="a3d-roam__meta"></p>
      <a class="a-btn a-btn--primary a-btn--sm a3d-roam__go" href="#top">Read more</a>
    </div>
  </div>
</div>
