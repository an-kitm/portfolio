---
import { toolkit } from '../../content/site';
---

<section id="toolkit" class="b-toolkit b-panel" data-nav="light" aria-labelledby="toolkit-title">
  <h2 id="toolkit-title" class="b-toolkit__label b-reveal">Toolkit</h2>
  <div class="b-toolkit__body b-serif">
    <p class="b-reveal" style="--i:1"><span class="b-toolkit__key">Analysis:</span> {toolkit.analysisProse}</p>
    <p class="b-reveal" style="--i:2"><span class="b-toolkit__key">Tools:</span> {toolkit.toolsProse}</p>
  </div>
</section>
