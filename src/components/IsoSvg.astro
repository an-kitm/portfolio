---
import type { IsoDrawing } from '../lib/iso';

interface Props {
  drawing: IsoDrawing;
  class?: string;
  /** Keep edge widths constant however large the drawing is scaled. */
  nonScalingStroke?: boolean;
  dash?: string;
}

const { drawing, class: className, nonScalingStroke = true, dash = '5 4' } = Astro.props;
---

<svg
  class={className}
  viewBox={`0 0 ${drawing.width} ${drawing.height}`}
  width={drawing.width}
  height={drawing.height}
  aria-hidden="true"
  focusable="false"
>
  {drawing.shadow && <polygon points={drawing.shadow.points} fill={drawing.shadow.fill} />}
  {
    drawing.faces.map((f) => (
      <polygon
        points={f.points}
        fill={f.fill}
        stroke={f.edge}
        stroke-width={f.edgeWidth}
        stroke-linejoin="round"
        stroke-dasharray={f.dashed ? dash : undefined}
        vector-effect={nonScalingStroke ? 'non-scaling-stroke' : undefined}
      />
    ))
  }
</svg>
